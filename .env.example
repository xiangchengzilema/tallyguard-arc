# Never commit real credentials.
TALLYGUARD_MODE=simulation
TALLYGUARD_ARC_NETWORK=ARC-TESTNET
TALLYGUARD_ALLOW_MAINNET=false
TALLYGUARD_MAX_TRANSFER_USDC=5.00
TALLYGUARD_DATABASE_PATH=data/tallyguard.sqlite3
# Set only when the built frontend is outside the repository root.
# TALLYGUARD_FRONTEND_DIST=/app/web/dist
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
CIRCLE_WEB3_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
