# Never commit real credentials.
TALLYGUARD_MODE=simulation
TALLYGUARD_ARC_NETWORK=ARC-TESTNET
TALLYGUARD_ALLOW_MAINNET=false
TALLYGUARD_MAX_TRANSFER_USDC=5.00
TALLYGUARD_RATE_LIMIT_PER_MINUTE=6000
TALLYGUARD_MAX_EVIDENCE_BYTES=10485760
TALLYGUARD_DATABASE_PATH=data/tallyguard.sqlite3
# Keep false for Circle-backed deployments. Simulation mode enables demo sessions automatically.
TALLYGUARD_ENABLE_DEMO_SESSIONS=false
# Optional hosted interpretation layer. Deterministic mode needs no credentials.
TALLYGUARD_AGENT_MODE=deterministic
TALLYGUARD_AGENT_URL=
TALLYGUARD_AGENT_API_KEY=
TALLYGUARD_AGENT_MODEL=
TALLYGUARD_AGENT_TIMEOUT_SECONDS=10
# Set only when the built frontend is outside the repository root.
# TALLYGUARD_FRONTEND_DIST=/app/web/dist
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
CIRCLE_WEB3_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
