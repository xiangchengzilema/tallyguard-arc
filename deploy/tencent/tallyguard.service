[Unit]
Description=TallyGuard Arc Testnet public simulation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tallyguard
Group=tallyguard
WorkingDirectory=/opt/tallyguard-arc
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TALLYGUARD_MODE=simulation
Environment=TALLYGUARD_ARC_NETWORK=ARC-TESTNET
Environment=TALLYGUARD_ALLOW_MAINNET=false
Environment=TALLYGUARD_MAX_TRANSFER_USDC=0.10
Environment=TALLYGUARD_ENABLE_DEMO_SESSIONS=true
Environment=TALLYGUARD_RATE_LIMIT_PER_MINUTE=6000
Environment=TALLYGUARD_DEMO_SESSION_RATE_LIMIT_PER_MINUTE=120
Environment=TALLYGUARD_MAX_ACTIVE_SESSIONS_PER_PRINCIPAL=32
Environment=TALLYGUARD_MAX_EVIDENCE_BYTES=10485760
Environment=TALLYGUARD_REQUEST_LOGS=true
Environment=TALLYGUARD_DATABASE_PATH=/var/lib/tallyguard/tallyguard.sqlite3
Environment=TALLYGUARD_FRONTEND_DIST=/opt/tallyguard-arc/web/dist
Environment=TALLYGUARD_RELIABILITY_REPORT=/opt/tallyguard-arc/docs/reports/load-test-10000.json
Environment=TALLYGUARD_AGENT_RELIABILITY_REPORT=/opt/tallyguard-arc/docs/reports/agent-run-load-50.json
Environment=TALLYGUARD_PUBLIC_ACTIVITY_SNAPSHOT=/opt/tallyguard-arc/docs/reports/arc-testnet-public-activity.json
ExecStart=/opt/tallyguard-arc/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 127.0.0.1:8180 --access-logfile - --error-logfile - tallyguard.api:create_app()
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tallyguard

[Install]
WantedBy=multi-user.target
